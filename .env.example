# ==========================================
# DISCORD BOT CREDENTIALS
# ==========================================
# Get your bot token from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# (Optional) Dev Guild ID for instant Slash Command syncing during development.
# If left empty, commands are synced globally (can take up to 1 hour to propagate).
DEV_GUILD_ID=

# ==========================================
# SPOTIFY DEVELOPER API CREDENTIALS
# ==========================================
# Create an app at: https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here

# ==========================================
# AUDIO & PLAYER SETTINGS
# ==========================================
# Path to FFmpeg executable (leave as 'ffmpeg' if in system PATH)
FFMPEG_PATH=ffmpeg

# Default volume (0 to 100)
DEFAULT_VOLUME=50

# Idle timeout in seconds before disconnecting from voice (e.g. 300 = 5 minutes)
IDLE_TIMEOUT_SECONDS=300

# ==========================================
# APPLICATION & LOGGING SETTINGS
# ==========================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

